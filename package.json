{
  "name": "tsukyio-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript & JavaScript SDK for the Tsukyio Creator Ecosystem",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "tsukyio",
    "amv",
    "after-effects",
    "video-editing",
    "raw-anime",
    "stem-splitter",
    "deadframes",
    "sdk",
    "api-client"
  ],
  "author": "Tsukyio <contact@tsukyio.com> (https://tsukyio.com)",
  "license": "MIT",
  "homepage": "https://tsukyio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moongetsu/tsukyio-sdk.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "sideEffects": false
}
